import tkinter as tk
from tkinter import messagebox
import json
import os

ARQUIVO = "catalogo.json"

# =================== LÓGICA ===================

def carregar_livros():
    if not os.path.exists(ARQUIVO):
        return []
    with open(ARQUIVO, "r", encoding="utf-8") as f:
        return json.load(f)

def salvar_livros(livros):
    with open(ARQUIVO, "w", encoding="utf-8") as f:
        json.dump(livros, f, indent=4, ensure_ascii=False)

def adicionar_livro():
    titulo = entrada_titulo.get().strip()
    autor = entrada_autor.get().strip()
    ano = entrada_ano.get().strip()
    genero = entrada_genero.get().strip()

    if not titulo or not autor or not ano or not genero:
        messagebox.showwarning("Campos obrigatórios", "Preencha todos os campos.")
        return

    try:
        int(ano)
    except ValueError:
        messagebox.showwarning("Ano inválido", "O ano deve ser um número.")
        return

    livros = carregar_livros()
    novo = {"titulo": titulo, "autor": autor, "ano": ano, "genero": genero}
    livros.append(novo)
    salvar_livros(livros)
    messagebox.showinfo("Sucesso", "Livro adicionado com sucesso!")
    limpar_campos()
    atualizar_lista(livros)

def buscar_livros():
    termo = entrada_busca.get().strip().lower()
    if not termo:
        messagebox.showwarning("Busca vazia", "Digite um título ou autor para buscar.")
        return
    livros = carregar_livros()
    encontrados = [l for l in livros if termo in l["titulo"].lower() or termo in l["autor"].lower()]
    atualizar_lista(encontrados)

def listar_todos():
    livros = carregar_livros()
    atualizar_lista(livros)

def atualizar_lista(lista):
    lista_resultados.delete(0, tk.END)
    if not lista:
        lista_resultados.insert(tk.END, "Nenhum livro encontrado.")
        return
    for l in lista:
        texto = f"{l['titulo']} | {l['autor']} | {l['ano']} | {l['genero']}"
        lista_resultados.insert(tk.END, texto)

def limpar_campos():
    entrada_titulo.delete(0, tk.END)
    entrada_autor.delete(0, tk.END)
    entrada_ano.delete(0, tk.END)
    entrada_genero.delete(0, tk.END)

# =================== INTERFACE ===================

janela = tk.Tk()
janela.title("📚 Catálogo de Livros")
janela.geometry("600x500")
janela.resizable(False, False)

# ---------- Área de Cadastro ----------
frame_cadastro = tk.LabelFrame(janela, text="Adicionar Livro", padx=10, pady=10)
frame_cadastro.pack(padx=10, pady=10, fill="x")

tk.Label(frame_cadastro, text="Título:").grid(row=0, column=0, sticky="w")
entrada_titulo = tk.Entry(frame_cadastro, width=40)
entrada_titulo.grid(row=0, column=1)

tk.Label(frame_cadastro, text="Autor:").grid(row=1, column=0, sticky="w")
entrada_autor = tk.Entry(frame_cadastro, width=40)
entrada_autor.grid(row=1, column=1)

tk.Label(frame_cadastro, text="Ano:").grid(row=2, column=0, sticky="w")
entrada_ano = tk.Entry(frame_cadastro, width=40)
entrada_ano.grid(row=2, column=1)

tk.Label(frame_cadastro, text="Gênero:").grid(row=3, column=0, sticky="w")
entrada_genero = tk.Entry(frame_cadastro, width=40)
entrada_genero.grid(row=3, column=1)

btn_adicionar = tk.Button(frame_cadastro, text="Adicionar", command=adicionar_livro, bg="lightgreen")
btn_adicionar.grid(row=4, column=1, pady=10, sticky="e")

# ---------- Área de Busca ----------
frame_busca = tk.LabelFrame(janela, text="Buscar Livros", padx=10, pady=10)
frame_busca.pack(padx=10, pady=5, fill="x")

entrada_busca = tk.Entry(frame_busca, width=40)
entrada_busca.pack(side="left", padx=(0, 10))
btn_buscar = tk.Button(frame_busca, text="Buscar", command=buscar_livros)
btn_buscar.pack(side="left")
btn_listar = tk.Button(frame_busca, text="Listar Todos", command=listar_todos)
btn_listar.pack(side="left", padx=(10, 0))

# ---------- Lista de Resultados ----------
frame_resultados = tk.LabelFrame(janela, text="Resultados", padx=10, pady=10)
frame_resultados.pack(padx=10, pady=5, fill="both", expand=True)

lista_resultados = tk.Listbox(frame_resultados, width=80, height=12)
lista_resultados.pack(side="left", fill="both", expand=True)

scrollbar = tk.Scrollbar(frame_resultados, orient="vertical")
scrollbar.config(command=lista_resultados.yview)
scrollbar.pack(side="right", fill="y")

lista_resultados.config(yscrollcommand=scrollbar.set)

# Inicia com todos os livros listados
listar_todos()

janela.mainloop()
